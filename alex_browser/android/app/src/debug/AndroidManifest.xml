<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running
         application to allow setting breakpoints, to provide hot reload,
         etc. It is merged into the app's manifest automatically for
         debug builds only (see the profile variant, which needs it for
         the same reason during profiling). -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
